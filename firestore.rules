rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isChatParticipant(data) {
      return signedIn()
        && data.keys().hasAny(['participants'])
        && data.participants is list
        && request.auth.uid in data.participants;
    }

    // Public profile discovery is restricted to authenticated app users.
    // Users may only create/update their own user document.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid);
      allow update: if isSelf(uid);
      allow delete: if false;
    }

    // Chat documents must list exactly the two UIDs represented by the deterministic room ID.
    // This also lets a participant repair a legacy chat document that predates the participants field,
    // without granting access to arbitrary chat documents.
    function validChatId(chatId, data) {
      return data.keys().hasAny(['participants'])
        && data.participants is list
        && data.participants.size() == 2
        && (
          chatId == data.participants[0] + '_' + data.participants[1]
          || chatId == data.participants[1] + '_' + data.participants[0]
        );
    }

    match /chats/{chatId} {
      // Keep the list rule aligned with whereArrayContains("participants", uid).
      // Existing legacy documents without a participants list are not readable.
      allow get: if signedIn() && request.auth.uid in resource.data.participants;
      allow list: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if isChatParticipant(request.resource.data)
                    && validChatId(chatId, request.resource.data);
      allow update: if isChatParticipant(request.resource.data)
                    && validChatId(chatId, request.resource.data)
                    && (isChatParticipant(resource.data)
                        || !resource.data.keys().hasAny(['participants']));
      allow delete: if false;

      match /messages/{messageId} {
        function parentChat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        allow read: if isChatParticipant(parentChat());
        allow create: if isChatParticipant(parentChat())
                      && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Call records are accessible only to listed participants.
    function isCallParticipant(data) {
      return signedIn()
        && (data.callerId == request.auth.uid
            || data.receiverId == request.auth.uid);
    }

    match /calls/{callId} {
      // Call lists query callerId/receiverId, so authorize against those same fields.
      allow get, list: if isCallParticipant(resource.data);
      allow create: if signedIn()
                    && request.resource.data.callerId == request.auth.uid
                    && request.resource.data.receiverId is string
                    && request.resource.data.receiverId != request.auth.uid
                    && request.resource.data.participants is list
                    && request.resource.data.participants.size() == 2
                    && request.resource.data.callerId in request.resource.data.participants
                    && request.resource.data.receiverId in request.resource.data.participants;
      allow update: if isCallParticipant(resource.data)
                    && request.resource.data.callerId == resource.data.callerId
                    && request.resource.data.receiverId == resource.data.receiverId
                    && request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      // ICE candidate access is restricted to the two call participants.
      match /callerCandidates/{candidateId} {
        function parentCall() {
          return get(/databases/$(database)/documents/calls/$(callId)).data;
        }
        allow read: if isCallParticipant(parentCall());
        allow create: if isCallParticipant(parentCall())
                      && parentCall().callerId == request.auth.uid;
        allow update, delete: if false;
      }

      match /calleeCandidates/{candidateId} {
        function parentCall() {
          return get(/databases/$(database)/documents/calls/$(callId)).data;
        }
        allow read: if isCallParticipant(parentCall());
        allow create: if isCallParticipant(parentCall())
                      && parentCall().receiverId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Payment orders are created/updated by trusted Cloud Functions only.
    match /paymentOrders/{orderId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Users can create a support ticket for themselves and read their own.
    match /supportTickets/{ticketId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Deny all other documents unless a specific rule above permits access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
